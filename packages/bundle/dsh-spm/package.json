{
  "name": "dsh-spm",
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "description": "MAST 的 SPM/STM 领域能力，作为 DeepSeek Harness 插件集",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-spm-compat": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.1"
  }
}
