{
  "name": "dsh-spm",
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "description": "MAST 的 SPM/STM 领域能力，作为 DeepSeek Harness 插件集",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./instrument-state": {
      "types": "./lib/types/instrument-state.d.ts",
      "default": "./lib/instrument-state.js"
    },
    "./minimal": {
      "types": "./lib/types/minimal.d.ts",
      "default": "./lib/minimal.js"
    },
    "./instrument-stmsim": {
      "types": "./lib/types/instrument-stmsim.d.ts",
      "default": "./lib/instrument-stmsim.js"
    },
    "./stm-ui": {
      "types": "./lib/types/stm-ui.d.ts",
      "default": "./lib/stm-ui.js"
    },
    "./watchdog": {
      "types": "./lib/types/watchdog.d.ts",
      "default": "./lib/watchdog.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "cordis.minimal.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-spm-compat": "workspace:*",
    "dsh-spm-instrument": "workspace:*",
    "dsh-spm-instrument-state": "workspace:*",
    "dsh-spm-instrument-stmsim": "workspace:*",
    "dsh-spm-instrument-watchdog": "workspace:*",
    "dsh-spm-kernel": "workspace:*",
    "dsh-spm-nanonis-wire": "workspace:*",
    "dsh-spm-stm-records": "workspace:*",
    "dsh-spm-stm-safety": "workspace:*",
    "dsh-spm-stm-skills": "workspace:*",
    "dsh-spm-stm-ui": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2"
  }
}
